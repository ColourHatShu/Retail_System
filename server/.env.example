# Copy to server/.env (gitignored) and fill in the real password.
# Supabase: Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Optional: separate database for `npm test` (tests create and drop throwaway schemas).
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/retail_test

# Optional
# PORT=5000
# PG_POOL_MAX=10
# PGSSL=disable   # only for a local Postgres without TLS
# PGSSL_CA=       # PEM of the server CA to enable strict certificate verification
